NEXT_PUBLIC_APTOS_NETWORK=testnet
NEXT_PUBLIC_CONTRACT_ADDRESS=
NEXT_PUBLIC_SHELBY_NETWORK=testnet
NEXT_PUBLIC_STORAGE_ADAPTER_MODE=shelby
NEXT_PUBLIC_SHELBY_API_KEY=your_client_api_key_here
NEXT_PUBLIC_MAX_UPLOAD_SIZE=26214400

AI_PROVIDER=openai
OPENAI_MODEL=gpt-4o-mini
OPENAI_API_KEY=your_server_side_api_key
AI_MAX_FILES=5
AI_MAX_FILE_BYTES=10485760
AI_MAX_TOTAL_CHARACTERS=200000
AI_PROMPT_VERSION=v1

# NOTES:
# - NEXT_PUBLIC_SHELBY_API_KEY is only the client/browser key. Do not put a server key here!
# - OPENAI_API_KEY is server-only. Do NOT prefix with NEXT_PUBLIC_.
# - Do NOT commit your .env.local file.
# - If you deploy on Railway, set these variables manually in the Railway Dashboard.
# - After changing NEXT_PUBLIC_* variables, you must redeploy/rebuild the frontend bundle.
